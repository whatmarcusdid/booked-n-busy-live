{
  "$description": "Book Service tokens. Sources: Figma Ynb50VwCrK1sOh77Tzkxv3 (page Branding) + live computed styles from bookservice.tech (Figma Sites) and my.bookservice.tech (Next.js, public pages only), crawled 2026-10-13. Light mode only (no dark mode planned yet). Rule: live site wins over Figma; Figma diffs are logged as 'update Figma to match'. $extensions.bookservice records provenance; nothing here is invented.",
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#34d399",
        "$description": "Brand green. CTA background; accent on dark.",
        "$extensions": {
          "bookservice": {
            "figmaVariable": "Primary",
            "live": "both"
          }
        }
      },
      "primary-hover": {
        "$type": "color",
        "$value": "#2fc48d",
        "$description": "Live only.",
        "$extensions": {
          "bookservice": {
            "live": "app CSS hover:!bg-[#2fc48d]"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#2920a5",
        "$description": "Brand indigo. App primary button, focus ring, links.",
        "$extensions": {
          "bookservice": {
            "figmaVariable": "Secondary",
            "live": "both"
          }
        }
      },
      "secondary-hover": {
        "$type": "color",
        "$value": "#211880",
        "$description": "Live only.",
        "$extensions": {
          "bookservice": {
            "live": "app CSS hover:bg-[#211880]"
          }
        }
      },
      "secondary-deep": {
        "$type": "color",
        "$value": "#171544",
        "$description": "Live only; role unknown.",
        "$extensions": {
          "bookservice": {
            "live": "marketing text (2 uses)"
          }
        }
      }
    },
    "bg": {
      "dark": {
        "$type": "color",
        "$value": "#0c0a28",
        "$extensions": {
          "bookservice": {
            "figmaVariable": "Dark BG",
            "live": "both"
          }
        }
      },
      "canvas": {
        "$type": "color",
        "$value": "#f8fafc",
        "$extensions": {
          "bookservice": {
            "figmaVariable": "Light BG",
            "live": "both"
          }
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Cards, inputs.",
        "$extensions": {
          "bookservice": {
            "figmaVariable": "Light",
            "live": "both"
          }
        }
      },
      "nav": {
        "$type": "color",
        "$value": "#fcfcfe",
        "$description": "Live only.",
        "$extensions": {
          "bookservice": {
            "live": "marketing nav bar"
          }
        }
      },
      "disabled": {
        "$type": "color",
        "$value": "#d1d5db",
        "$extensions": {
          "bookservice": {
            "live": "app disabled button"
          }
        }
      }
    },
    "text": {
      "strong": {
        "$type": "color",
        "$value": "#030712",
        "$description": "Headings / body on light. Figma uses Dark BG or raw black here.",
        "$extensions": {
          "bookservice": {
            "live": "most common live text (Tailwind gray-950)"
          }
        }
      },
      "body": {
        "$type": "color",
        "$value": "#232521",
        "$extensions": {
          "bookservice": {
            "live": "marketing body copy"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#52525b",
        "$extensions": {
          "bookservice": {
            "live": "both sites (Tailwind zinc-600)"
          }
        }
      },
      "on-dark": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "bookservice": {
            "figmaVariable": "Light",
            "live": "both"
          }
        }
      },
      "on-primary": {
        "$type": "color",
        "$value": "#0c0a28",
        "$description": "Text on green. Live app value; marketing #000 is non-standard. Update Figma to match.",
        "$extensions": {
          "bookservice": {
            "figmaVariable": "Dark BG",
            "live": "app CTA text"
          }
        }
      },
      "disabled": {
        "$type": "color",
        "$value": "#52525b",
        "$extensions": {
          "bookservice": {
            "live": "app disabled button text"
          }
        }
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#e5e7eb",
        "$extensions": {
          "bookservice": {
            "live": "both (Tailwind gray-200)"
          }
        }
      },
      "input": {
        "$type": "color",
        "$value": "#d1d5db",
        "$extensions": {
          "bookservice": {
            "live": "app inputs on /book-call, /signin"
          }
        }
      }
    },
    "feedback": {
      "error": {
        "$type": "color",
        "$value": "#e7000b",
        "$description": "No success/warning/info found.",
        "$extensions": {
          "bookservice": {
            "live": "app CSS (Tailwind v4 red-600 value)"
          }
        }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "#2920a5",
        "$description": "App also uses #1D4ED8, #2563EB, #1B4A41, #9be382 rings; consolidate on this.",
        "$extensions": {
          "bookservice": {
            "figmaVariable": "Secondary",
            "live": "app focus-visible:ring-[#2920a5]"
          }
        }
      }
    }
  },
  "gradient": {
    "gradient-1": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#1f0fb8",
          "position": 0
        },
        {
          "color": "#560fb8",
          "position": 0.25
        },
        {
          "color": "#8e0eb7",
          "position": 0.5
        },
        {
          "color": "#b80fa0",
          "position": 0.75
        },
        {
          "color": "#b80f3a",
          "position": 1
        }
      ],
      "$description": "180deg linear. Figma also layers a 'Mesh gradient' shader at 20% opacity (WebGPU) \u2014 not representable in CSS.",
      "$extensions": {
        "figma": {
          "style": "Gradient 1",
          "node": "151:1932",
          "angle": "180deg"
        }
      }
    },
    "gradient-2": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#177fb0",
          "position": 0
        },
        {
          "color": "#174fb0",
          "position": 0.25
        },
        {
          "color": "#171fb1",
          "position": 0.5
        },
        {
          "color": "#4117b0",
          "position": 0.75
        },
        {
          "color": "#7317b0",
          "position": 1
        }
      ],
      "$description": "180deg linear + 20% mesh shader overlay (see gradient-1).",
      "$extensions": {
        "figma": {
          "style": "Gradient 2",
          "node": "151:1934",
          "angle": "180deg"
        }
      }
    },
    "gradient-3": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#03ab7e",
          "position": 0
        },
        {
          "color": "#03a0ab",
          "position": 0.25
        },
        {
          "color": "#0469aa",
          "position": 0.5
        },
        {
          "color": "#0336ab",
          "position": 0.75
        },
        {
          "color": "#0603ab",
          "position": 1
        }
      ],
      "$description": "180deg linear + 20% mesh shader overlay (see gradient-1).",
      "$extensions": {
        "figma": {
          "style": "Gradient 3",
          "node": "151:1935",
          "angle": "180deg"
        }
      }
    }
  },
